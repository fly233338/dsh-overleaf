{
  "manifest_version": 3,
  "name": "dsh-overleaf Free Bridge",
  "version": "0.2.0",
  "description": "Connects a signed-in Overleaf Free project to the local dsh-overleaf MCP server.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://overleaf.com/*",
    "https://*.overleaf.com/*",
    "http://127.0.0.1:47832/*",
    "http://localhost:47832/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://overleaf.com/project/*", "https://*.overleaf.com/project/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sync this project with dsh-overleaf"
  },
  "options_page": "options.html"
}
