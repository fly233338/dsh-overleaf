{
  "name": "dsh-overleaf",
  "version": "0.1.1",
  "description": "DSH bundle that exposes multiple Overleaf projects through OverleafMCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/fly233338/dsh-overleaf.git"
  },
  "homepage": "https://github.com/fly233338/dsh-overleaf#readme",
  "bugs": {
    "url": "https://github.com/fly233338/dsh-overleaf/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "overleaf",
    "mcp",
    "latex"
  ],
  "type": "module",
  "main": "./index.js",
  "bin": {
    "dsh-overleaf-mcp": "./mcp.js"
  },
  "exports": {
    ".": "./index.js",
    "./config": "./config.js",
    "./mcp": "./mcp.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "config.js",
    "mcp.js",
    "browser-server.js",
    "extension/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.5"
  },
  "dependencies": {
    "@mjyoo2/overleaf-mcp": "1.0.0",
    "fflate": "^0.8.2"
  }
